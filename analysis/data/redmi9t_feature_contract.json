  "strata": {
    "primary": "base_mut",
    "secondary": [
      "mut_mut",
      "pooled"
    ],
    "rule": "base_mut is the primary stratum. mut_mut orientation is arbitrary and adds no independent seeds."
  },
  "fit_order_inside_each_training_fold": [
    "impute: not required (no missing values); if a later snapshot has any, fit on train only",
    "scale: RobustScaler for linear and margin-based learners, skip for tree ensembles; fit on train only",
    "select: any feature selection is fitted on train only, never on the full corpus",
    "resample: prefer class weights; the corpus is near-balanced"
  ],
  "metrics": [
    "roc_auc",
    "average_precision",
    "mcc",
    "balanced_accuracy",
    "accuracy",
    "f1",
    "precision",
    "recall",
    "specificity",
    "brier",
    "log_loss"
  ],
  "baselines_required": {
    "majority_class_accuracy": {
      "base_mut": 0.5813253012048193,
      "mut_mut": 0.5053475935828877,
      "pooled": 0.5226960110041265
    },
    "single_feature_rule": "d_treeNonConstWidgetCount > 0",
    "alias_feature_rule": "d_usesLayoutDependentBuilder > 0",
    "directive_identity_oracle": "one-hot of the right-hand role. Not a competitor - the directive is unavailable at prediction time - but a ceiling the feature model is measured against."
  },
  "uncertainty": {
    "method": "group-level block bootstrap",
    "resample": "whole seed groups with replacement, never rows",
    "draws": 2000,
    "seed": 20260803,
    "why": "Contrasts within a seed group share code lineage and share role executions, so a row-level interval understates uncertainty in proportion to how many contrasts each group contributed. The per-pair delta bootstrap from stage 01 is a different object and must never be reused as a model-level interval."
  },
  "required_analyses": [
    "label-permutation test, >= 200 permutations, on the balanced logistic regression",
    "leave-one-directive-out evaluation",
    "ablation with d_usesLayoutDependentBuilder removed",
    "sensitivity on the ambiguous rows",
    "sensitivity on the labelling endpoint (delta > 0.474)"
  ],
